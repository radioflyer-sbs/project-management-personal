# Host port nginx listens on. Application will be at http://localhost:PORT
PM_PORT=80

# MongoDB connection string. Defaults to the pm-mongo service managed by this
# docker-compose.yml. Override only if you want to point at an external MongoDB.
MONGO_CONNECTION_STRING=mongodb://pm-mongo:27017

# MongoDB database name
MONGO_DATABASE_NAME=project-management-db

# JWT secret — this app does not enforce auth, but the value must be present.
# Change to any random string.
JWT_SECRET=change-me-to-a-random-string
